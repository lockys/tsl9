  "narrative": {
    "northStar": "Concept02 — forest-teal native utility",
    "overview": "The implemented identity pairs a warm light canvas with restrained forest teal, white containers and a floating capsule navigation bar. It is a native Android utility: controls, language handling and diagnostic text remain familiar, while shared surfaces and line icons connect the three destinations.\n\nThis record describes the current `0.7.1-test` source, including the neutral Android package and portable build scripts. The implementation is the authority where the concept image or earlier screenshots differ. It does not establish physical-device, vehicle or hardware verification.",
    "keyCharacteristics": [
      "One action accent, with sage selection and explicit muted disabled states.",
      "Scrollable single-column pages with paired controls and metric tiles.",
      "Persistent connection context and three labeled icon destinations.",
      "Advanced content behind explicit disclosures; native confirmations remain visible when invoked."
    ],
    "rules": [
      {
        "name": "The State Has Two Channels Rule",
        "body": "Selection and availability use both text/icon treatment and surface treatment. Do not make a control appear enabled by accent color alone.",
        "section": "colors"
      },
      {
        "name": "The Unknown Stays Unknown Rule",
        "body": "Keep unknown, absent and stale data distinguishable through the implemented labels, dashes and muted/amber treatment. Never fill the interface with demonstration readings.",
        "section": "colors"
      },
      {
        "name": "The Reachable Detail Rule",
        "body": "Reduce initial density with explicit disclosure controls while retaining the detailed content, diagnostics, firmware format options and exports in the same destination.",
        "section": "layout"
      },
      {
        "name": "The Navigation Lift Rule",
        "body": "Preserve the navigation capsule's hierarchy without adding shadows to ordinary cards or actions.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do reuse the shared `AppUi` colors, surfaces, button states and line icons.",
      "Do preserve explicit unknown/stale labels and native enabled/disabled state.",
      "Do retain labeled destinations, accessible icon controls and native font scaling.",
      "Do keep advanced information reachable through named disclosures.",
      "Do use `sp` for text and `dp` for geometry in the native implementation."
    ],
    "donts": [
      "Don't replace received-data placeholders with sample values.",
      "Don't add elevated cards or button shadows to the flat content surfaces.",
      "Don't substitute emoji or text glyphs for the implemented geometric icons.",
      "Don't hide confirmation, stop or cancellation behavior to simplify a screen.",
      "Don't infer a custom field, dialog, motion or responsive token from platform defaults."
    ]
  }
